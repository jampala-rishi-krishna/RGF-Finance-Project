# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_publishable_key

# ── SerpAPI (LinkedIn verification) ───────────────────────────────────────
SERPAPI_KEY=your_serpapi_key
# Used only for optional LinkedIn verification. Lender web search uses
# DuckDuckGo Lite directly and does not require this key.

# ── Auth credentials ──────────────────────────────────────────────────────
ADMIN_PASSWORD=your_admin_password
MANAGER_PASSWORD=your_manager_password
ADMIN_EMAIL_PASSWORD=your_admin_email_password
RISHI_EMAIL_PASSWORD=your_rishi_password
